APP_NAME="7 Rent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=video-store
DB_USERNAME=video-store
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# TMDB (cadastro de filmes e gêneros): chave gratuita em https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Use false só em desenvolvimento, se o certificado da rede bloquear o SSL
TMDB_VERIFY_SSL=true

# Horas que o cliente tem para retirar o filme depois de reservar
RENTAL_RESERVATION_HOURS=24
