diff --git a/tests/Feature/AdminRentalFilterTest.php b/tests/Feature/AdminRentalFilterTest.php
new file mode 100644
index 0000000..891bf95
--- /dev/null
+++ b/tests/Feature/AdminRentalFilterTest.php
@@ -0,0 +1,68 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Movie;
+use App\Models\Rental;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ * Abas "Cancelados" e "Expirados" da lista de aluguéis do admin.
+ */
+class AdminRentalFilterTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->withoutVite();
+
+        $title = fn(string $t) => Movie::factory()->create(['title' => $t])->id;
+
+        Rental::factory()->reserved()->create(['movie_id' => $title('Reserva Aberta')]);
+        Rental::factory()->lapsed()->create(['movie_id' => $title('Reserva Vencida')]);
+        Rental::factory()->expired()->create(['movie_id' => $title('Reserva Expirada')]);
+        Rental::factory()->cancelled()->create(['movie_id' => $title('Reserva Cancelada')]);
+    }
+
+    private function list(?string $status)
+    {
+        return $this->actingAs(User::factory()->create(['is_admin' => true]))
+            ->get(route('admin.rentals.index', $status ? ['status' => $status] : []));
+    }
+
+    public function test_cancelled_tab_lists_only_cancelled_reservations(): void
+    {
+        $this->list('cancelled')->assertOk()
+            ->assertSee('Reserva Cancelada')
+            ->assertDontSee('Reserva Aberta')
+            ->assertDontSee('Reserva Vencida')
+            ->assertDontSee('Reserva Expirada');
+    }
+
+    public function test_expired_tab_includes_lapsed_reservations_not_yet_marked(): void
+    {
+        $this->list('expired')->assertOk()
+            ->assertSee('Reserva Expirada')
+            ->assertSee('Reserva Vencida')
+            ->assertDontSee('Reserva Aberta')
+            ->assertDontSee('Reserva Cancelada');
+    }
+
+    public function test_reserved_tab_does_not_include_lapsed_reservations(): void
+    {
+        $this->list('reserved')->assertOk()
+            ->assertSee('Reserva Aberta')
+            ->assertDontSee('Reserva Vencida');
+    }
+
+    public function test_the_new_tabs_are_shown(): void
+    {
+        $this->list(null)->assertOk()
+            ->assertSee('Cancelados')
+            ->assertSee('Expirados');
+    }
+}
diff --git a/tests/Feature/GenreStoreTest.php b/tests/Feature/GenreStoreTest.php
new file mode 100644
index 0000000..2265107
--- /dev/null
+++ b/tests/Feature/GenreStoreTest.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Genre;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ * Cadastro de gênero pelo TMDB: pela tela de gêneros (redirect) e pela tela de filme (JSON).
+ */
+class GenreStoreTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function admin(): User
+    {
+        return User::factory()->create(['is_admin' => true]);
+    }
+
+    public function test_json_request_creates_the_genre_and_returns_it(): void
+    {
+        $this->actingAs($this->admin())
+            ->postJson(route('admin.genres.store'), ['tmdb_id' => 10770, 'name' => 'Cinema TV'])
+            ->assertCreated()
+            ->assertJsonPath('tmdb_id', 10770)
+            ->assertJsonPath('name', 'Cinema TV');
+
+        $this->assertDatabaseHas('genres', ['tmdb_id' => 10770, 'name' => 'Cinema TV']);
+    }
+
+    public function test_sending_the_same_tmdb_id_twice_does_not_duplicate_the_genre(): void
+    {
+        $admin = $this->admin();
+        $payload = ['tmdb_id' => 10770, 'name' => 'Cinema TV'];
+
+        $first = $this->actingAs($admin)->postJson(route('admin.genres.store'), $payload)->assertCreated();
+        $this->actingAs($admin)->postJson(route('admin.genres.store'), $payload)
+            ->assertOk()
+            ->assertJsonPath('id', $first->json('id'));
+
+        $this->assertSame(1, Genre::count());
+    }
+
+    public function test_a_name_used_by_another_tmdb_id_is_refused_with_a_message(): void
+    {
+        Genre::factory()->create(['tmdb_id' => 1, 'name' => 'Terror']);
+
+        $this->actingAs($this->admin())
+            ->postJson(route('admin.genres.store'), ['tmdb_id' => 2, 'name' => 'Terror'])
+            ->assertStatus(422)
+            ->assertJsonStructure(['message']);
+
+        $this->assertSame(1, Genre::count());
+    }
+
+    public function test_form_request_with_a_name_in_use_goes_back_with_an_error(): void
+    {
+        Genre::factory()->create(['tmdb_id' => 1, 'name' => 'Terror']);
+
+        $this->actingAs($this->admin())
+            ->from(route('admin.genres.create'))
+            ->post(route('admin.genres.store'), ['tmdb_id' => 2, 'name' => 'Terror'])
+            ->assertRedirect(route('admin.genres.create'))
+            ->assertSessionHasErrors('name');
+
+        $this->assertSame(1, Genre::count());
+    }
+
+    public function test_form_request_for_an_existing_genre_does_not_claim_success(): void
+    {
+        Genre::factory()->create(['tmdb_id' => 28, 'name' => 'Ação']);
+
+        $this->actingAs($this->admin())
+            ->post(route('admin.genres.store'), ['tmdb_id' => 28, 'name' => 'Ação'])
+            ->assertRedirect(route('admin.genres.index'))
+            ->assertSessionHas('error')
+            ->assertSessionMissing('status');
+
+        $this->assertSame(1, Genre::count());
+    }
+
+    public function test_form_request_for_a_new_genre_redirects_with_success(): void
+    {
+        $this->actingAs($this->admin())
+            ->post(route('admin.genres.store'), ['tmdb_id' => 28, 'name' => 'Ação'])
+            ->assertRedirect(route('admin.genres.index'))
+            ->assertSessionHas('status');
+
+        $this->assertDatabaseHas('genres', ['tmdb_id' => 28]);
+    }
+
+    public function test_tmdb_id_and_name_are_required(): void
+    {
+        $this->actingAs($this->admin())
+            ->postJson(route('admin.genres.store'), [])
+            ->assertStatus(422)
+            ->assertJsonValidationErrors(['tmdb_id', 'name']);
+    }
+
+    public function test_customers_cannot_create_genres(): void
+    {
+        $this->actingAs(User::factory()->create(['is_admin' => false]))
+            ->postJson(route('admin.genres.store'), ['tmdb_id' => 28, 'name' => 'Ação'])
+            ->assertForbidden();
+
+        $this->assertSame(0, Genre::count());
+    }
+}
